[Unit]
Description=Wallpaper (hyprpaper), kept running on its own
# Its own service, not a child of the Panacea shell: restarting or crashing the
# shell used to take hyprpaper down with it, leaving the desktop without a wallpaper.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/hyprpaper
Restart=always
RestartSec=1
