[Unit]
Description=Wallpaper (hyprpaper), kept running on its own
# Its own service, not a child of the Panacea shell: restarting or crashing the
# shell used to take hyprpaper down with it, leaving the desktop without a wallpaper.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# its own config, never touched by Panacea: no race with Panacea's login rewrite (no splash quote)
ExecStartPre=%h/.config/hypr/custom/bin/hyprpaper-conf
ExecStart=/usr/bin/hyprpaper -c %h/.config/hypr/custom/hyprpaper.conf
Restart=always
RestartSec=1
